# Mars environment template.  Copy to `.env` and fill in real values.
# Never commit `.env`: it is git-ignored.

# --- model access (required) -------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MARS_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free
# MARS_MODEL_FAST=nvidia/nemotron-3-ultra-550b-a55b:free
# MARS_MODEL_PLANNER=nvidia/nemotron-3-ultra-550b-a55b:free
# MARS_MODEL_FALLBACKS=anthropic/claude-sonnet-4.5,openai/gpt-5-mini
# MARS_STRICT_MODEL_REGISTRY=false

# --- prompt release ----------------------------------------------------------
# The built-in bundle is versioned in src/mars/prompt_meta.py.  An optional
# reviewed override file can replace protocol blocks and add agent suffixes
# without a code deploy; see the "Prompt versioning and rollback" section of
# README.md.  Non-prod channels emit a startup warning.
# MARS_PROMPT_VERSION=2026-10-27.p4-prompt-registry
# MARS_PROMPT_CHANNEL=prod
# MARS_PROMPT_OVERRIDES=

# --- optional search providers ----------------------------------------------
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# EXA_API_KEY=

# --- research defaults -------------------------------------------------------
# Mars is domain-locked to Agentic AI. MARS_TOPIC selects a subtopic inside
# that domain; off-domain topics are rejected at startup.
# MARS_TOPIC=agentic AI
# MARS_DEPTH=standard
# MARS_OUTPUT_DIR=./research_output

# --- spend and reliability ceilings -----------------------------------------
# MARS_MAX_LLM_CALLS_PER_RUN=160
# MARS_MAX_TOKENS_PER_RUN=
# MARS_MAX_COST_USD=
# MARS_MAX_TOKENS_PER_TRACK=
# MARS_MAX_COST_USD_PER_TRACK=
# MARS_STRICT_PRICING=false
# MARS_MAX_LLM_RETRIES=2
# MARS_RETRY_BASE_SECONDS=1
# MARS_RETRY_MAX_SECONDS=20
# MARS_CIRCUIT_FAILURE_THRESHOLD=4
# MARS_CIRCUIT_RECOVERY_SECONDS=30
# MARS_CIRCUIT_WAIT_SECONDS=40

# --- storage (state, archive, traces, approvals) ----------------------------
# MARS_CACHE_DIR=/var/lib/mars/cache
# MARS_STATE_DIR=/var/lib/mars/runs
# MARS_ARCHIVE_DIR=/var/lib/mars/evidence
# MARS_DEAD_LETTER_DIR=/var/lib/mars/dead_letters
# MARS_OBSERVABILITY_DIR=/var/lib/mars/traces
# MARS_APPROVAL_DIR=./.mars_approvals
# MARS_RETENTION_DAYS=30

# --- governance and privacy --------------------------------------------------
# MARS_RESPECT_ROBOTS=true
# MARS_ROBOTS_FAIL_CLOSED=false
# MARS_ALLOWED_DOMAINS=
# MARS_BLOCKED_DOMAINS=
# MARS_BLOCKED_URL_PATTERNS=
# MARS_MIN_SOURCE_QUALITY=0.35
# MARS_MAX_SOURCES_PER_DOMAIN=5
# MARS_MAX_SOURCE_AGE_DAYS=
# MARS_BLOCK_PAYWALLED=false
# MARS_ARCHIVE_ENABLED=true
# MARS_REDACT_PII=true
# MARS_ENCRYPTION_KEY=
# MARS_ENCRYPT_STATE=false

# --- UI authentication (required to run the Streamlit UI) -------------------
# MARS_UI_PASSWORD=
# MARS_UI_USERNAME=admin
# MARS_APPROVAL_SECRET=
